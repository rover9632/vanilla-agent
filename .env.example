# Deployment environment template — copy to `.env` at the repo root and edit.
# `.env` itself is git-ignored and must never be committed (docs/plan.md §8.6).
#
# The variable set below is the complete, closed deployment surface enforced by
# `service/app/core/env.py` (T0.2). Capability parameters (model, limits, tool
# enablement, sandbox network mode, budgets, ...) are NOT env vars — they live
# in `config/*.yaml` (ADR-015); if you feel the urge to add one here, it almost
# certainly belongs in config instead.
#
# There is deliberately no SESSION_SECRET / cookie signing key: sessions are
# opaque tokens verified by DB lookup (ADR-004, plan §11).

# --- provider credentials (required; the single global key, plan §13-D2) -----
# Only read by the service process; injected into sandboxes never.
OPENAI_API_KEY=<replaceme>

# --- deployment paths (all optional; defaults shown) ---------------------------
# Relative values are anchored at REPO_ROOT; `~` is expanded. REPO_ROOT itself
# must be an absolute path, and it also decides where `.env` is read from.
# Setting any of these to an empty value is an error, not "use the default".
#REPO_ROOT=/absolute/path/to/repo    # default: this checkout
#DATA_DIR=data                      # holds vanilla.db, artifacts/, workspaces/, backups/
#CONFIG_DIR=config
#DATABASE_PATH=data/vanilla.db      # defaults to <DATA_DIR>/vanilla.db

# --- session policy (ADR-004; defaults are production-safe) --------------------
#SESSION_TTL_DAYS=30                # sliding expiry, 1..365
#SESSION_COOKIE_SECURE=1            # set 0 ONLY for local http development

# --- dev-only switches (must stay off in production, plan §8.4/§8.7) -----------
#ALLOW_LOCAL_SANDBOX=0              # 1 = run tools directly on host, no Docker isolation
#CONFIG_ALLOW_LOCAL=0               # 1 = let `config/*.local.yaml` override tracked config

# --- sandbox image (built by `make sandbox-build`) ------------------------------
#SANDBOX_IMAGE=vanilla-agent/sandbox:latest
